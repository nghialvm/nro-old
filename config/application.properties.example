# Server
server.local=false
server.test=false
server.daoautoupdater=false
server.sv=1
server.name=NRO Server
server.ip=127.0.0.1
server.port=14445
# Optional additional server entry. Add server.sv2 through server.sv10 as needed.
server.sv1=NRO Server:127.0.0.1:14445
server.waitlogin=5
server.maxperip=5
server.maxplayer=1000
server.expserver=1

# Database
database.driver=org.mariadb.jdbc.Driver
database.host=127.0.0.1
database.port=3306
database.name=nro
database.user=root
database.pass=
database.min=1
database.max=10
database.lifetime=1800000
database.log=false
